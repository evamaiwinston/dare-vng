# LLM endpoint
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://your-endpoint.com
LLM_MODEL=model-name
SHELL_TOKENIZER=gpt2

# Attribution params
LASSO_ALPHA=0.01

# Throttle and retry
API_CALL_DELAY=0.5
API_MAX_RETRIES=3
API_RETRY_BACKOFF=10.0
API_TIMEOUT_CONNECT=10
API_TIMEOUT_READ=90

# Concurrent workers for widget
WIDGET_MAX_WORKERS=8


# Embeddings (for --signals)
EMBED_MODEL=intfloat/multilingual-e5-base

# Capacity limits (for local-model-mini)
MINI_MAX_RESPONSE_CHARS=
MINI_MAX_CONTEXT_CHARS=
